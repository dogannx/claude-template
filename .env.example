# Copy to .env and fill in. NEVER commit the real .env.

# --- App ---
APP_ENV=development
APP_PORT=8080

# --- Database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_dev
# Used by bun / pgx
DATABASE_URL=postgres://app:change-me@db:5432/app_dev?sslmode=disable

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
